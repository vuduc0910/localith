# Ollama local API
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB vector store
CHROMA_URL=http://127.0.0.1:8000
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Crawl defaults
CRAWL_DEPTH=3
MAX_PAGES=200
CRAWL_DELAY_MS=900
PAGE_TIMEOUT_MS=30000
MAX_SNAPSHOT_CHARS=18000
MAX_PAGE_TEXT_CHARS=16000

# Optional: include subdomains of the starting host (true/false)
INCLUDE_SUBDOMAINS=false

# Respect robots.txt (true/false)
RESPECT_ROBOTS=true

# Auth wall handling (optional)
# Enable with: localith scan <url> --auth
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=your-password

# HTTP server (localith serve). HOST defaults to 127.0.0.1 because the API has no authentication.
# PORT=3000
# HOST=127.0.0.1

# Path to the agent-browser executable, if it is not found automatically
# AGENT_BROWSER_BIN=
